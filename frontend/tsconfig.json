{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "jsx": "react",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "outFile": "dist/app.js",
    "removeComments": false,
    "sourceMap": false
  },
  "files": [
    "src/global.d.ts",
    "src/app.tsx"
  ]
}
